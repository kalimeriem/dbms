# Copy to `.env` and fill in your real values.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=at_recouvrement

# Or set the full URL directly (overrides the fields above if present):
# DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/at_recouvrement

CORS_ORIGINS=http://localhost:5173
ENV=development

# --- Rappels de versement (clients ENGAGÉS sans versement) ---
REMINDER_DELAY_DAYS=30
REMINDER_CHECK_INTERVAL_HOURS=24
REMINDER_SCHEDULER_ENABLED=true
REMINDER_COUNT_PENDING=true
